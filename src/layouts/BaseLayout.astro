---
import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';
import config from '../../astro-theme-config';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  ogImageUrl?: string;
  type?: 'website' | 'article';
  pubDate?: string;
  updatedDate?: string;
  robots?: string;
  canonicalUrl?: string;
  pageUrl?: string;
  lang?: string;
  locale?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  image,
  ogImageUrl,
  type,
  pubDate,
  updatedDate,
  robots,
  canonicalUrl,
  pageUrl,
  lang,
  locale,
  bodyClass,
} = Astro.props;
const htmlLang = lang ?? config.site.lang;
---

<!doctype html>
<html lang={htmlLang} data-smooth-scroll={config.behavior.smoothScroll ? 'true' : 'false'}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      ogImageUrl={ogImageUrl}
      type={type}
      pubDate={pubDate}
      updatedDate={updatedDate}
      robots={robots}
      canonicalUrl={canonicalUrl}
      pageUrl={pageUrl}
      locale={locale}
    />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      import { mountImageLoadingStates } from '../scripts/image-loading';
      import { mountSkipLinkFocus } from '../scripts/skip-link';
      import { mountScrollAnimations } from '../scripts/scroll-animations';

      function onNav(fn: () => void) {
        fn();
        document.addEventListener('astro:page-load', fn);
      }

      onNav(mountSkipLinkFocus);
      onNav(mountImageLoadingStates);
      onNav(mountScrollAnimations);
    </script>
  </body>
</html>

<style is:global>
  :root {
    --header-clearance: calc(var(--nav-height) + var(--space-6));
  }

  html {
    scroll-padding-top: var(--header-clearance);
  }

  main {
    width: 100%;
    margin: 0 auto;
    padding: var(--header-clearance) 0 var(--space-8);
  }
</style>
