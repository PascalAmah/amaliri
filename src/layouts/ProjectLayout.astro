---
import '../styles/layouts/project.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';

import Container from '../components/Container.astro';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import FeaturedProjectGrid from '../components/FeaturedProjectGrid.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import ScrollFocus from '../components/ScrollFocus.astro';
import Section from '../components/Section.astro';
import BaseLayout from './BaseLayout.astro';
import { SITE_AUTHOR, SITE_LANG, SITE_TITLE } from '../consts';
import { getUiText } from '../ui';
import { withBase } from '../utils/paths';
import { serializeScriptJson } from '../utils/serialize-script-json';

type Props = CollectionEntry<'projects'>['data'] & {
  projectId?: string;
  readingTime?: number;
  relatedProjects?: CollectionEntry<'projects'>[];
  uiImages?: ImageMetadata[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  projectId,
  focusEffect,
  githubUrl,
  liveUrl,
  status,
  relatedProjects = [],
  uiImages,
  tags = [],
  problem,
  whatWasBuilt,
  highlights,
  challenges,
  metrics,
  architecture,
} = Astro.props;

const tr = getUiText();
const projectsBase = withBase('/projects');

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pubDateISO = pubDate.toISOString();
const updatedDateISO = updatedDate?.toISOString();

const jsonLd = serializeScriptJson({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDateISO,
  ...(updatedDateISO && { dateModified: updatedDateISO }),
  url: canonicalURL.href,
  ...(heroImage && { image: new URL(heroImage.src, Astro.site).href }),
  author: { '@type': 'Person', name: SITE_AUTHOR },
  publisher: { '@type': 'Organization', name: SITE_TITLE },
  inLanguage: SITE_LANG,
});
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  pubDate={pubDateISO}
  updatedDate={updatedDateISO}
  bodyClass="project-page"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  {focusEffect && <ScrollFocus variant={focusEffect} />}

  <Container variant="showcase" transition:animate="slide">
    <article>
      <div class="project-content">
        <a href={projectsBase} class="back-link">{tr.backLink}</a>

      <header class="project-header">
        <div class="project-accent"></div>
        {status === 'in-progress' && (
          <span class="project-status">
            <span class="project-status-dot" aria-hidden="true" />
            In Development
          </span>
        )}
        <h1 class="project-title">{title}</h1>
        {description && <p class="project-description">{description}</p>}
        {
          (githubUrl || liveUrl) && (
            <div class="action-buttons">
              {githubUrl && (
                <a href={githubUrl} target="_blank" rel="noopener noreferrer">
                  GitHub
                </a>
              )}
              {liveUrl && (
                <a href={liveUrl} target="_blank" rel="noopener noreferrer">
                  Live
                </a>
              )}
            </div>
          )
        }
        {
          tags.length > 0 && (
            <div class="project-tags">
              {tags.map((tag) => (
                <span class="project-tag">{tag}</span>
              ))}
            </div>
          )
        }
      </header>

      {
        heroImage && (
          <div class="project-hero" data-reveal>
            <Image
              src={heroImage}
              alt={`${title} hero image`}
              widths={[800, 1200, 1600]}
              sizes="(max-width: 600px) 100vw, (max-width: 900px) 90vw, 720px"
              quality={90}
              class="project-hero-img image-fade-in"
              transition:name={`project-hero-${projectId}`}
            />
          </div>
        )
      }

      <div class="project-divider"></div>

      {
        metrics && metrics.length > 0 && (
          <ul class="project-metrics" data-reveal-group>
            {metrics.map((m) => (
              <li class="project-metric">
                <span class="project-metric-value">{m.value}</span>
                <span class="project-metric-label">{m.label}</span>
              </li>
            ))}
          </ul>
        )
      }

      {
        (problem || whatWasBuilt || (highlights && highlights.length > 0) || challenges) && (
          <section class="project-overview">
            {problem && (
              <div class="overview-block" data-reveal>
                <p class="overview-label">The Problem</p>
                <p class="overview-text">{problem}</p>
              </div>
            )}
            {whatWasBuilt && (
              <div class="overview-block" data-reveal>
                <p class="overview-label">What Was Built</p>
                <p class="overview-text">{whatWasBuilt}</p>
              </div>
            )}
            {highlights && highlights.length > 0 && (
              <div class="overview-block" data-reveal>
                <p class="overview-label">Highlights</p>
                <ul class="highlights-list" data-reveal-group>
                  {highlights.map((item) => (
                    <li class="highlights-item">{item}</li>
                  ))}
                </ul>
              </div>
            )}
            {challenges && (
              <div class="overview-block engineering-callout" data-reveal>
                <p class="overview-label">Engineering Decisions</p>
                <p class="overview-text">{challenges}</p>
              </div>
            )}
          </section>
        )
      }

      {
        architecture && architecture.length > 0 && (
          <div class="overview-block" data-reveal>
            <p class="overview-label">Architecture</p>
            <ArchitectureDiagram nodes={architecture} />
          </div>
        )
      }

      <div class="prose" id="prose-content">
        <slot />
      </div>
      </div>

      {
        uiImages && uiImages.length > 0 && (
          <Section label="Screenshots" data-reveal>
            <div class="screenshots-grid" data-reveal-group>
              {uiImages.map((img, i) => (
                <a href={img.src} class="screenshot-item image-fade-in" data-lightbox>
                  <Image
                    src={img}
                    alt={`${title} screenshot ${i + 1}`}
                    widths={[400, 800]}
                    sizes="(max-width: 600px) calc(50vw - 24px), 360px"
                    quality={90}
                    class="screenshot-img"
                  />
                </a>
              ))}
            </div>
          </Section>
        )
      }

      {
        relatedProjects.length > 0 && (
          <Section label={tr.relatedProjects} variant="default">
            <FeaturedProjectGrid projects={relatedProjects} variant="related" />
            <Fragment slot="actions">
              <a href={projectsBase} class="related-view-all">
                {tr.allProjects}
              </a>
            </Fragment>
          </Section>
        )
      }
    </article>
  </Container>
  <ImageLightbox />

</BaseLayout>
