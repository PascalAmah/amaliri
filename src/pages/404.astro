---
import '../styles/pages/not-found.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title="Page not found"
  description="The page you requested does not exist."
  robots="noindex, follow"
  canonicalUrl={withBase('/404.html')}
  pageUrl={withBase('/404.html')}
>
  <div class="not-found-inner" data-reveal>
    <p class="not-found-code">404</p>
    <h1 class="not-found-title">Page not found</h1>
    <p class="not-found-desc">The URL may be wrong, or the page may have been removed.</p>
    <div class="not-found-actions">
      <Button href={withBase('/')} variant="primary">Home</Button>
      <Button href={withBase('/projects')} variant="secondary">All projects</Button>
    </div>
  </div>
</BaseLayout>
