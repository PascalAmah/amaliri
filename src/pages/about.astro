---
import '../styles/pages/about.css';
import config from '../../astro-theme-config';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const profileImageUrl = config.about.profileImage.trim();
const hasProfileImage = profileImageUrl.length > 0;
const profileName = config.about.name || config.site.author;
const profileRole = config.about.role;
const profileLocation = config.about.location;
const profileFocus = config.about.focus;
const profileLead = config.about.lead;
const statementLabel = config.about.statementLabel;
const statementTitle = config.about.statementTitle;
const careerLabel = config.about.careerLabel;
const careerItems = config.about.career;
const focusItems = config.about.interests;
const interestsLabel = config.about.interestsLabel;
const interestsHeading = config.about.interestsHeading;
const journeyLabel = config.about.journeyLabel;
const journeyHeading = config.about.journeyHeading;
const journeyParagraphs = config.about.journey ?? [];
const certificationsLabel = config.about.certificationsLabel;
const certificationsHeading = config.about.certificationsHeading;
const certifications = config.about.certifications ?? [];
const profileLinks = [
  {
    label: 'GitHub',
    href: config.social.github,
  },
  {
    label: 'Website',
    href: config.social.website,
  },
  {
    label: 'LinkedIn',
    href: config.social.linkedin,
  },
  {
    label: 'Email',
    href: config.social.email ? `mailto:${config.social.email}` : '',
  },
].filter((link) => link.href);
---

<BaseLayout title="About" description={profileLead} bodyClass="about-layout">
  <div class="about-main">
    <Breadcrumbs
      items={[
        { label: 'Home', path: '/' },
        { label: 'About', path: '/about' },
      ]}
    />
    <section class="about-hero" aria-labelledby="about-title">
      <div class="about-intro" data-reveal>
        <p class="about-lead">
          {profileLead}
        </p>
      </div>

      <aside
        class:list={['profile-panel', !hasProfileImage && 'profile-panel--text']}
        aria-label="Profile preview"
        data-reveal
      >
        {
          hasProfileImage && (
            <figure class="profile-media">
              <img
                src={profileImageUrl}
                width="720"
                height="720"
                alt={`${profileName} profile portrait`}
                loading="eager"
                referrerpolicy="no-referrer"
              />
            </figure>
          )
        }
        <div class="profile-summary">
          <p class="profile-name">{profileName}</p>
          <p class="profile-role">{profileRole}</p>
        </div>
        <dl class="profile-meta">
          <div>
            <dt>Location</dt>
            <dd>{profileLocation}</dd>
          </div>
          <div>
            <dt>Focus</dt>
            <dd>{profileFocus}</dd>
          </div>
          {
            profileLinks.length > 0 && (
              <div>
                <dt>Links</dt>
                <dd class="profile-links">
                  {profileLinks.map((link) => (
                    <a
                      href={link.href}
                      target={link.href.startsWith('mailto:') ? undefined : '_blank'}
                      rel={link.href.startsWith('mailto:') ? undefined : 'noopener'}
                    >
                      {link.label}
                    </a>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>
      </aside>
    </section>

    {
      journeyParagraphs.length > 0 && (
        <section class="about-section about-journey" aria-labelledby="about-journey" data-reveal>
          <p class="section-label">{journeyLabel}</p>
          <div>
            <h2 id="about-journey" class="section-heading">{journeyHeading}</h2>
            <div class="journey-prose">
              {journeyParagraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="about-section about-skills" aria-labelledby="about-skills" data-reveal>
      <p class="section-label">{statementLabel}</p>
      <div>
        <h2 id="about-skills" class="section-heading">
          {statementTitle}
        </h2>
        <ul class="skills-grid">
          {config.skills.map((category) => (
            <li class="skills-category">
              <p class="skills-category-label">{category.label}</p>
              <div class="skills-tags">
                {category.names.map((name) => (
                  <span class="skills-badge">{name}</span>
                ))}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="about-section" aria-label={careerLabel} data-reveal>
      <p class="section-label">{careerLabel}</p>
      <div class="career-list" data-reveal-group>
        {
          careerItems.map((item) => (
            <article class="career-item">
              <time>{item.period}</time>
              <div class="career-body">
                <h3>{item.title}</h3>
                <p class="career-company">{item.description}</p>
                <p class="career-meta">
                  <span class="career-type">{item.type}</span>
                  {item.remote && <span class="career-remote">· Remote</span>}
                </p>
                {item.bullets && item.bullets.length > 0 && (
                  <ul class="career-bullets">
                    {item.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    {
      certifications.length > 0 && (
        <section class="about-section about-certs" aria-labelledby="about-certs" data-reveal>
          <p class="section-label">{certificationsLabel}</p>
          <div>
            <h2 id="about-certs" class="section-heading">{certificationsHeading}</h2>
            <ul class="certs-list" data-reveal-group>
              {certifications.map((cert) => {
                const CardTag = cert.credentialUrl ? 'a' : 'div';
                return (
                  <li class="cert-item">
                    <CardTag
                      class:list={['cert-card', cert.credentialUrl && 'cert-card--link']}
                      {...(cert.credentialUrl
                        ? { href: cert.credentialUrl, target: '_blank', rel: 'noopener' }
                        : {})}
                    >
                      {cert.logo && (
                        <span class="cert-logo" aria-hidden="true">
                          <img src={cert.logo} alt="" loading="lazy" width="48" height="48" />
                        </span>
                      )}
                      <div class="cert-body">
                        <h3 class="cert-title">{cert.title}</h3>
                        <p class="cert-issuer">{cert.issuer}</p>
                      </div>
                      <div class="cert-meta">
                        <span class="cert-year">{cert.year}</span>
                        {cert.credentialUrl && (
                          <span class="cert-verify" aria-hidden="true">
                            View credential →
                          </span>
                        )}
                      </div>
                    </CardTag>
                  </li>
                );
              })}
            </ul>
          </div>
        </section>
      )
    }

    <section class="about-section" aria-labelledby="about-focus" data-reveal>
      <p class="section-label">{interestsLabel}</p>
      <div>
        <h2 id="about-focus" class="section-heading">{interestsHeading}</h2>
        <ul class="focus-list">
          {focusItems.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
