---
import '../../styles/pages/projects-index.css';
import { getCollection } from 'astro:content';
import ProjectFeed from '../../components/ProjectFeed.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION } from '../../consts';
import { getUiText } from '../../ui';

const tr = getUiText();

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={tr.projectsTitle} description={SITE_DESCRIPTION}>
  <main id="main-content" class="projects-main">
    <div class="projects-header" data-reveal>
      <div>
        <p class="projects-label eyebrow-accent">{tr.projectsEyebrow}</p>
        <h1 class="projects-title">{tr.projectsTitle}</h1>
      </div>
    </div>

    <ProjectFeed projects={projects} basePath="/projects" initialVisible={8} />
  </main>
</BaseLayout>
