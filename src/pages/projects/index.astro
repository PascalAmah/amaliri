---
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectFeed from '../../components/ProjectFeed.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import { SITE_DESCRIPTION } from '../../consts';
import { getUiText } from '../../ui';

const tr = getUiText();

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={tr.projectsTitle} description={SITE_DESCRIPTION} bodyClass="projects-layout">
  <Container variant="showcase">
    <Breadcrumbs
      items={[
        { label: 'Home', path: '/' },
        { label: 'Projects', path: '/projects' },
      ]}
    />
    <Section label={tr.projectsEyebrow} heading={tr.projectsTitle} variant="showcase" data-reveal>
      <ProjectFeed projects={projects} basePath="/projects" initialVisible={8} />
    </Section>
  </Container>
</BaseLayout>
