---
import config from '../../astro-theme-config';
import Button from './Button.astro';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import { isNavItemActive } from '../utils/nav-active';
import { withBase, withoutBase } from '../utils/paths';

const skipLinkLabel = 'Skip to content';
const navAriaLabel = 'Primary navigation';
const headerTitle = config.site.logoLabel || config.site.title;
const pathname = withoutBase(Astro.url.pathname);
const navItems = [...config.nav, { label: 'Contact', href: '/#contact' }].map((item) => ({
  ...item,
  active: isNavItemActive(pathname, item.href),
}));
const resumeUrl = config.site.resumeUrl;
---

<a href="#main-content" class="skip-link" tabindex="0">{skipLinkLabel}</a>
<div class="site-header" transition:persist="site-header">
  <nav class="nav-island" aria-label={navAriaLabel}>
    <a href={withBase('/')} class="nav-logo" aria-label={headerTitle}>
      <img src="/logo-c.jpg" alt={headerTitle} class="nav-logo-img" width="120" height="40" />
    </a>

    <div class="nav-links">
      {navItems.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
    </div>

    <div class="nav-right">
      {
        resumeUrl && (
          <Button
            href={withBase(resumeUrl)}
            variant="outline"
            size="sm"
            class="nav-resume"
            target="_blank"
            rel="noopener"
          >
            Résumé
          </Button>
        )
      }
      <ThemeToggle />
      <button
        type="button"
        class="nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="nav-toggle-bar" aria-hidden="true"></span>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </nav>
</div>

<!-- Backdrop — fades in behind the menu on mobile -->
<div class="mobile-backdrop" aria-hidden="true"></div>

<div class="mobile-menu" id="mobile-menu" transition:persist="mobile-menu">
  <nav class="mobile-menu-nav" aria-label="Mobile navigation">
    {
      navItems.map((item) => (
        <a
          href={withBase(item.href)}
          data-nav-href={item.href}
          aria-current={item.active ? 'page' : undefined}
          class:list={['mobile-menu-link', { active: item.active }]}
        >
          {item.label}
        </a>
      ))
    }
    {
      resumeUrl && (
        <a
          href={withBase(resumeUrl)}
          class="mobile-menu-link mobile-menu-link--cta"
          target="_blank"
          rel="noopener"
        >
          Résumé ↓
        </a>
      )
    }
  </nav>
</div>

<script is:inline>
  (function () {
    function mountAutoHideHeader() {
      const header = document.querySelector('.site-header');
      if (!(header instanceof HTMLElement) || header.dataset.scrollReady === 'true') return;
      header.dataset.scrollReady = 'true';

      let lastY = window.scrollY;
      let ticking = false;

      const sync = () => {
        const currentY = window.scrollY;
        const delta = currentY - lastY;
        const activeElement = document.activeElement;
        const hasKeyboardFocus =
          activeElement instanceof HTMLElement &&
          header.contains(activeElement) &&
          activeElement.matches(':focus-visible');

        header.classList.toggle('is-scrolled', currentY > 8);

        if (currentY < 24 || hasKeyboardFocus || document.body.classList.contains('menu-open')) {
          header.classList.remove('is-hidden');
        } else if (delta > 8 && currentY > 96) {
          header.classList.add('is-hidden');
        } else if (delta < -8) {
          header.classList.remove('is-hidden');
        }

        lastY = currentY;
        ticking = false;
      };

      sync();
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            window.requestAnimationFrame(sync);
            ticking = true;
          }
        },
        { passive: true }
      );
    }

    function mountMobileMenu() {
      const toggle = document.querySelector('.nav-toggle');
      const menu = document.getElementById('mobile-menu');
      const backdrop = document.querySelector('.mobile-backdrop');
      if (!(toggle instanceof HTMLElement) || !menu) return;

      const close = () => {
        document.body.classList.remove('menu-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
      };
      const open = () => {
        document.body.classList.add('menu-open');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Close menu');
      };

      // Always reset to a clean closed state on (re)init and after each navigation.
      close();

      if (toggle.dataset.ready === 'true') return;
      toggle.dataset.ready = 'true';

      toggle.addEventListener('click', () => {
        document.body.classList.contains('menu-open') ? close() : open();
      });

      // Close on backdrop click.
      if (backdrop) {
        backdrop.addEventListener('click', close);
      }

      // Delegated so it survives even if the link set changes.
      menu.addEventListener('click', (e) => {
        if (e.target instanceof Element && e.target.closest('a')) close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && document.body.classList.contains('menu-open')) close();
      });
    }

    function mountActiveNavSync() {
      const header = document.querySelector('.site-header');
      if (!header) return;
      // The header survives Astro view transitions (persisted DOM), so bind this
      // once and re-sync on every navigation instead of stacking listeners.
      if (window.__navActiveSyncBound) return;
      window.__navActiveSyncBound = true;

      const normalize = (p) => {
        const trimmed = p.replace(/\/+$/, '');
        return trimmed === '' ? '/' : trimmed;
      };

      const sync = () => {
        const current = normalize(window.location.pathname);
        document.querySelectorAll('[data-nav-href]').forEach((el) => {
          const link = el;
          const resolved = link.getAttribute('href') || '/';
          // Hash links (e.g. /#contact) point at the homepage — never active.
          const isHashLink = resolved.includes('#');
          const target = isHashLink ? '/' : normalize(resolved.split('#')[0]);
          const active =
            !isHashLink &&
            target !== '/' &&
            (current === target || current.startsWith(target + '/'));
          link.classList.toggle('active', active);
          if (active) {
            link.setAttribute('aria-current', 'page');
          } else {
            link.removeAttribute('aria-current');
          }
        });
      };

      // Sync as soon as the links are in the DOM, then again after every
      // navigation or back/forward cache restore so the pill never goes stale.
      sync();
      document.addEventListener('astro:page-load', sync);
      window.addEventListener('pageshow', sync);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', sync, { once: true });
      }
    }

    function init() {
      mountAutoHideHeader();
      mountMobileMenu();
      mountActiveNavSync();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
    document.addEventListener('astro:page-load', init);
  })();
</script>

<style>
  /* ── Floating header shell ── */
  .site-header {
    position: fixed;
    top: var(--space-3);
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding-inline: var(--space-4);
    pointer-events: none;
    transition: transform var(--duration-normal) var(--ease-out);
    will-change: transform;
  }

  .site-header.is-hidden {
    transform: translateY(calc(-100% - var(--space-6)));
  }

  /* ── The glass island ── */
  .nav-island {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    width: fit-content;
    max-width: calc(100% - var(--space-4));
    height: var(--nav-height);
    padding: 0 var(--space-3) 0 var(--space-5);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--bg-primary) 62%, transparent);
    border: 1px solid color-mix(in srgb, var(--label-primary) 10%, transparent);
    backdrop-filter: saturate(180%) blur(18px);
    -webkit-backdrop-filter: saturate(180%) blur(18px);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 8px 24px rgba(0, 0, 0, 0.06);
    transition:
      background var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .site-header.is-scrolled .nav-island {
    background: color-mix(in srgb, var(--bg-primary) 80%, transparent);
    border-color: color-mix(in srgb, var(--label-primary) 14%, transparent);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.06),
      0 12px 32px rgba(0, 0, 0, 0.1);
  }

  :global([data-theme='dark']) .nav-island {
    background: color-mix(in srgb, var(--bg-primary) 55%, transparent);
    border-color: color-mix(in srgb, #ffffff 12%, transparent);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.3),
      0 8px 28px rgba(0, 0, 0, 0.45);
  }

  :global([data-theme='dark']) .site-header.is-scrolled .nav-island {
    background: color-mix(in srgb, var(--bg-primary) 74%, transparent);
    border-color: color-mix(in srgb, #ffffff 16%, transparent);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .nav-logo:hover {
    opacity: 0.7;
  }

  .nav-logo-img {
    height: clamp(22px, 5vw, 30px);
    width: auto;
    display: block;
    object-fit: contain;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* ── Hamburger toggle ── */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .nav-toggle-bar {
    width: 20px;
    height: 2px;
    background: var(--label-primary);
    border-radius: 2px;
    transition:
      transform var(--duration-normal) var(--ease-out),
      opacity var(--duration-fast) var(--ease-out);
    transform-origin: center;
  }

  /* Hamburger → X animation */
  :global(.menu-open) .nav-toggle-bar:nth-child(1) {
    transform: translateY(3.5px) rotate(45deg);
  }

  :global(.menu-open) .nav-toggle-bar:nth-child(2) {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* ── Backdrop ── */
  .mobile-backdrop {
    position: fixed;
    inset: 0;
    z-index: 98;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  :global(.menu-open) .mobile-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── Mobile menu panel ── */
  .mobile-menu {
    position: fixed;
    inset: calc(var(--nav-height) + var(--space-5)) var(--space-4) auto var(--space-4);
    z-index: 99;
    background: color-mix(in srgb, var(--bg-primary) 92%, transparent);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border: 1px solid color-mix(in srgb, var(--label-primary) 10%, transparent);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-lg);
    overflow: hidden;

    /* Closed state */
    opacity: 0;
    transform: translateY(-12px) scale(0.96);
    pointer-events: none;
    transition:
      opacity var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-spring);
  }

  :global(.menu-open) .mobile-menu {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .mobile-menu-nav {
    display: flex;
    flex-direction: column;
    padding: var(--space-2) var(--space-5) var(--space-4);
  }

  .mobile-menu-link {
    padding: var(--space-4) 0;
    font-size: var(--text-title-3);
    font-weight: var(--weight-medium);
    color: var(--label-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--separator);
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity var(--duration-slow) var(--ease-out),
      transform var(--duration-slow) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  /* Staggered link reveal */
  :global(.menu-open) .mobile-menu-link {
    opacity: 1;
    transform: translateX(0);
  }

  :global(.menu-open) .mobile-menu-link:nth-child(1) {
    transition-delay: 60ms;
  }
  :global(.menu-open) .mobile-menu-link:nth-child(2) {
    transition-delay: 120ms;
  }
  :global(.menu-open) .mobile-menu-link:nth-child(3) {
    transition-delay: 180ms;
  }
  :global(.menu-open) .mobile-menu-link:nth-child(4) {
    transition-delay: 240ms;
  }

  .mobile-menu-link:last-child {
    border-bottom: none;
  }

  .mobile-menu-link--cta {
    color: var(--accent-strong);
    font-weight: var(--weight-semibold);
  }

  /* ── Active page in the mobile menu ── */
  .mobile-menu-link.active {
    color: var(--accent-strong);
    font-weight: var(--weight-semibold);
  }

  /* ── Responsive visibility ── */
  @media (max-width: 640px) {
    .nav-links,
    .nav-resume {
      display: none;
    }

    .nav-right {
      margin-left: auto;
    }

    .nav-toggle {
      display: flex;
    }
  }

  @media (min-width: 641px) {
    .mobile-menu,
    .mobile-backdrop {
      display: none;
    }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }

    .nav-toggle-bar {
      transition: none;
    }

    .mobile-backdrop,
    .mobile-menu,
    .mobile-menu-link {
      transition: none;
    }
  }
</style>
