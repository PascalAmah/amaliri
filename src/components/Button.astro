---
interface SharedProps {
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  class?: string;
  children?: any;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  disabled = false,
  class: className,
  ...rest
} = Astro.props as SharedProps & ({ href: string } | Record<string, never>);
---

{
  href ? (
    <a
      href={href}
      aria-disabled={disabled ? 'true' : undefined}
      class:list={['btn', `btn--${variant}`, `btn--${size}`, className, { 'btn--disabled': disabled }]}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button
      disabled={disabled}
      class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
      {...rest}
    >
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-weight: var(--weight-semibold);
    line-height: 1;
    border-radius: var(--radius-full);
    cursor: pointer;
    text-decoration: none;
    border: none;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-spring),
      background-color var(--duration-fast) var(--ease-out);
  }

  /* ── Sizes ── */
  .btn--sm {
    padding: 6px 14px;
    font-size: var(--text-footnote);
  }

  .btn--md {
    padding: var(--space-2) var(--space-5);
    font-size: var(--text-callout);
  }

  .btn--lg {
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-body);
  }

  /* ── Variants ── */

  .btn--primary {
    background-color: var(--accent-strong);
    color: #fff;
  }

  .btn--primary:hover {
    opacity: 0.85;
  }

  .btn--secondary {
    background-color: var(--fill-secondary);
    color: var(--label-primary);
    border: 1px solid var(--fill-primary);
  }

  .btn--secondary:hover {
    opacity: 0.85;
  }

  .btn--ghost {
    background-color: transparent;
    color: var(--label-secondary);
  }

  .btn--ghost:hover {
    background-color: var(--fill-secondary);
  }

  .btn--outline {
    background-color: transparent;
    color: var(--accent-strong);
    border: 1px solid var(--accent-strong);
  }

  .btn--outline:hover {
    background-color: var(--fill-quaternary);
  }

  /* ── Active state ── */
  .btn:active {
    transform: scale(0.97);
  }

  /* ── Focus-visible ── */
  .btn:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 2px;
  }

  /* ── Disabled ── */
  .btn--disabled,
  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }
</style>
