---
import config from '../../astro-theme-config';
import Container from './Container.astro';
import { withBase } from '../utils/paths';

const today = new Date();
const footerTitle = config.site.title;
const footerLinks = [...config.footerNav, { label: 'Contact', href: '/#contact' }].filter(
  (item) => item.href !== '/'
);

const socialLinks = [
  { label: 'GitHub', href: config.social.github },
  { label: 'LinkedIn', href: config.social.linkedin },
  { label: 'X', href: config.social.twitter },
  { label: 'Email', href: config.social.email ? `mailto:${config.social.email}` : '' },
].filter((link) => link.href);
---

<footer class="site-footer" transition:persist="site-footer">
  <Container as="div">
    <div class="footer-grid">
      <div class="footer-identity">
        <p class="footer-name">{footerTitle}</p>
        <p class="footer-tagline">Backend-focused software engineer — Lagos, Nigeria.</p>
      </div>

      {
        footerLinks.length > 0 && (
          <nav class="footer-col" aria-label="Footer navigation">
            <p class="footer-col-label">Navigate</p>
            {footerLinks.map((item) => (
              <a href={withBase(item.href)} class="footer-link footer-nav-link">
                {item.label}
              </a>
            ))}
          </nav>
        )
      }

      {
        socialLinks.length > 0 && (
          <nav class="footer-col" aria-label="Social links">
            <p class="footer-col-label">Elsewhere</p>
            {socialLinks.map((link) => (
              <a
                href={link.href}
                class="footer-link"
                target={link.href.startsWith('mailto:') ? undefined : '_blank'}
                rel={link.href.startsWith('mailto:') ? undefined : 'noopener'}
              >
                {link.label}
              </a>
            ))}
          </nav>
        )
      }
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">&copy; {today.getFullYear()} {footerTitle}. Built with Astro.</p>
      <a href="#main-content" class="footer-top">Back to top ↑</a>
    </div>
  </Container>

  <script>
    document.addEventListener('click', (e) => {
      const link = e.target.closest('.footer-nav-link');
      if (!link) return;
      document.addEventListener(
        'astro:after-swap',
        () => {
          window.scrollTo({ top: 0, behavior: 'instant' });
        },
        { once: true }
      );
    });
  </script>
</footer>

<style>
  .site-footer {
    background: transparent;
    padding: var(--space-16) 0 var(--space-10);
    margin-top: var(--space-20);
    border-top: 1px solid var(--separator);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: var(--text-title-3);
    font-weight: var(--weight-bold);
    color: var(--label-primary);
    margin: 0 0 var(--space-2);
  }

  .footer-tagline {
    font-size: var(--text-footnote);
    color: var(--label-tertiary);
    margin: 0;
    max-width: 32ch;
    line-height: var(--leading-normal);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-col-label {
    font-size: var(--text-caption-1);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--label-quaternary);
    margin: 0 0 var(--space-1);
  }

  .footer-link {
    font-size: var(--text-footnote);
    color: var(--label-secondary);
    text-decoration: none;
    width: fit-content;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-link:hover {
    color: var(--label-primary);
    opacity: 1;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--separator);
    flex-wrap: wrap;
  }

  .footer-copy {
    font-size: var(--text-caption-1);
    color: var(--label-tertiary);
    margin: 0;
  }

  .footer-top {
    font-size: var(--text-caption-1);
    color: var(--label-tertiary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-top:hover {
    color: var(--label-primary);
    opacity: 1;
  }

  @media (max-width: 600px) {
    .site-footer {
      margin-top: var(--space-16);
      padding-top: var(--space-12);
    }

    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8) var(--space-6);
    }

    .footer-identity {
      grid-column: 1 / -1;
    }
  }
</style>
