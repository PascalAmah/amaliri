---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '../utils/paths';

type Props = HTMLAttributes<'a'> & {
  href: string;
  title: string;
  description?: string;
  tags?: string[];
  image?: {
    src: ImageMetadata | string;
    alt: string;
  };
  variant?: 'default' | 'featured';
  aspectRatio?: string;
};

const {
  href,
  title,
  description,
  tags,
  image,
  variant = 'default',
  aspectRatio = '4/3',
  class: className,
} = Astro.props;
---

<a
  href={withBase(href)}
  class:list={['card', `card--${variant}`, className]}
  aria-label={title}
>
  {image && (
    <div class="card__media" style={`aspect-ratio: ${aspectRatio}`}>
      {
        typeof image.src === 'string'
          ? <img src={withBase(image.src)} alt={image.alt} class="card__image" />
          : <Image src={image.src} alt={image.alt} class="card__image" />
      }
    </div>
  )}
  <div class="card__body">
    <h3 class="card__title">{title}</h3>
    {description && <p class="card__description">{description}</p>}
    {tags && tags.length > 0 && (
      <div class="card__tags">
        {tags.map((tag) => (
          <span class="card__tag">{tag}</span>
        ))}
      </div>
    )}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--bg-secondary);
    border: 1px solid var(--fill-primary);
    transition:
      transform var(--duration-normal) var(--ease-spring),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  /* ── Featured variant ── */
  .card--featured {
    border-color: var(--accent-strong);
    box-shadow: 0 0 0 1px var(--accent-strong);
  }

  .card--featured:hover {
    box-shadow: var(--shadow-md), 0 0 0 1px var(--accent-strong);
  }

  /* ── Media ── */
  .card__media {
    position: relative;
    overflow: hidden;
    background-color: var(--fill-tertiary);
  }

  .card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .card:hover .card__image {
    transform: scale(1.04);
  }

  /* ── Body ── */
  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    flex: 1;
  }

  .card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-headline);
    font-weight: var(--weight-semibold);
    color: var(--label-primary);
    line-height: var(--leading-snug);
  }

  .card__description {
    margin: 0;
    font-size: var(--text-callout);
    color: var(--label-secondary);
    line-height: var(--leading-normal);
  }

  /* ── Tags ── */
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .card__tag {
    display: inline-flex;
    align-items: center;
    padding: 2px 7px;
    font-size: var(--text-caption-1);
    font-weight: var(--weight-medium);
    border-radius: var(--radius-xs);
    background-color: var(--fill-secondary);
    border: 1px solid var(--fill-primary);
    color: var(--label-secondary);
    white-space: nowrap;
  }
</style>
