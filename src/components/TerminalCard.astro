---
/**
 * TerminalCard — decorative hero visual for the backend brand.
 * Content is real (skills/status from config), not fabricated metrics.
 * Typing animation is progressive enhancement; static content renders without JS.
 */
type Line = { cmd?: string; out?: string };

type Props = {
  lines: Line[];
  class?: string;
};

const { lines, class: className } = Astro.props;
---

<div class:list={['terminal', className]} role="img" aria-label="Terminal showing Pascal's stack and status">
  <div class="terminal-bar" aria-hidden="true">
    <span class="terminal-dot terminal-dot--red"></span>
    <span class="terminal-dot terminal-dot--amber"></span>
    <span class="terminal-dot terminal-dot--green"></span>
    <span class="terminal-title">~/pascal — zsh</span>
  </div>
  <div class="terminal-body">
    {
      lines.map((line) => (
        <div class="terminal-line">
          {line.cmd !== undefined ? (
            <>
              <span class="terminal-prompt" aria-hidden="true">$</span>
              <span class="terminal-cmd">{line.cmd}</span>
            </>
          ) : (
            <span class="terminal-out">{line.out}</span>
          )}
        </div>
      ))
    }
    <div class="terminal-line terminal-line--cursor" aria-hidden="true">
      <span class="terminal-prompt">$</span>
      <span class="terminal-cursor"></span>
    </div>
  </div>
</div>

<style>
  .terminal {
    width: 100%;
    max-width: 26rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--separator);
    background: #0b0f11;
    box-shadow: var(--shadow-lg);
    font-family: var(--font-mono);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 10px var(--space-4);
    background: #15191c;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .terminal-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .terminal-dot--red {
    background: #ff5f57;
  }
  .terminal-dot--amber {
    background: #febc2e;
  }
  .terminal-dot--green {
    background: #28c840;
  }

  .terminal-title {
    margin-left: auto;
    font-size: var(--text-caption-2);
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.02em;
  }

  .terminal-body {
    padding: var(--space-4) var(--space-5) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: var(--text-footnote);
    line-height: 1.5;
  }

  .terminal-line {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    min-height: 1.2em;
  }

  .terminal-prompt {
    color: var(--accent-bright);
    font-weight: 600;
    flex-shrink: 0;
  }

  .terminal-cmd {
    color: #e8edf0;
  }

  .terminal-out {
    color: rgba(232, 237, 240, 0.62);
    padding-left: calc(var(--space-2) + 0.6em);
  }

  .terminal-cursor {
    display: inline-block;
    width: 8px;
    height: 1em;
    background: var(--accent-bright);
    transform: translateY(2px);
    animation: terminal-blink 1.1s steps(1) infinite;
  }

  @keyframes terminal-blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  /* Typing reveal — progressive enhancement */
  .terminal[data-animate='true'] .terminal-line:not(.terminal-line--cursor) {
    opacity: 0;
    animation: terminal-line-in 260ms var(--ease-out) forwards;
  }

  @keyframes terminal-line-in {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-cursor {
      animation: none;
    }
    .terminal[data-animate='true'] .terminal-line {
      opacity: 1;
      animation: none;
    }
  }
</style>

<script>
  function mountTerminal() {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('.terminal').forEach((term) => {
      if (term.dataset.ready === 'true') return;
      term.dataset.ready = 'true';
      if (prefersReduced) return;

      const lines = term.querySelectorAll<HTMLElement>(
        '.terminal-line:not(.terminal-line--cursor)'
      );
      term.dataset.animate = 'true';
      lines.forEach((line, i) => {
        line.style.animationDelay = `${i * 320 + 200}ms`;
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mountTerminal);
  } else {
    mountTerminal();
  }
  document.addEventListener('astro:page-load', mountTerminal);
</script>
