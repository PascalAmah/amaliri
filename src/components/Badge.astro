---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'default' | 'accent' | 'outline';
type Size = 'sm' | 'md';

type Props = HTMLAttributes<'span'> & {
  variant?: Variant;
  size?: Size;
  icon?: string;
};

const { variant = 'default', size = 'sm', icon, class: className } = Astro.props;
---

<span class:list={['badge', `badge--${variant}`, `badge--${size}`, className]}>
  {icon && <img src={icon} alt="" class="badge__icon" />}
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
  }

  /* ── Sizes ── */
  .badge--sm {
    padding: 2px 7px;
    font-size: var(--text-caption-1);
    border-radius: var(--radius-xs);
  }

  .badge--md {
    padding: 4px 10px;
    font-size: var(--text-callout);
    border-radius: var(--radius-sm);
  }

  /* ── Variants ── */

  .badge--default {
    background-color: var(--fill-secondary);
    border: 1px solid var(--fill-primary);
    color: var(--label-secondary);
    font-weight: var(--weight-medium);
  }

  .badge--accent {
    background-color: var(--accent-strong);
    color: #fff;
    font-weight: var(--weight-semibold);
  }

  .badge--outline {
    background-color: transparent;
    border: 1px solid var(--separator);
    color: var(--label-tertiary);
  }

  /* ── Icon ── */
  .badge__icon {
    width: var(--badge-icon-size, 12px);
    height: auto;
    flex-shrink: 0;
    opacity: 0.7;
  }
</style>
