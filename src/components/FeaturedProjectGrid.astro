---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/paths';

type ProjectEntry = CollectionEntry<'projects'>;

type Props = {
  projects: ProjectEntry[];
  basePath?: string;
  variant?: 'home' | 'related';
};

const { projects, basePath = '/projects', variant = 'home' } = Astro.props;
const projectSlug = (id: string) => id;
const placeholderEntries = await Promise.all(
  projects.map(
    async (project) =>
      [
        project.id,
        project.data.heroImage
          ? (
              await getImage({
                src: project.data.heroImage,
                width: 48,
                format: 'webp',
                quality: 28,
              })
            ).src
          : undefined,
      ] as const
  )
);
const imagePlaceholderById = new Map<string, string | undefined>(placeholderEntries);
const imagePlaceholderStyle = (src: string | undefined) =>
  src ? `--tone-image-placeholder: url("${src}");` : undefined;
---

<div class:list={['featured-project-grid', `featured-project-grid--${variant}`]} data-reveal-group>
  {
    projects.map((project, index) => {
      const slides = project.data.uiImages?.length
        ? project.data.uiImages
        : project.data.heroImage
          ? [project.data.heroImage]
          : null;
      const hasSlides = slides && slides.length > 1;
      return (
        <a
          href={withBase(`${basePath}/${projectSlug(project.id)}/`)}
          class:list={['featured-project-card', `featured-project-card--slot-${index + 1}`]}
          data-slideshow={hasSlides ? 'true' : undefined}
          data-slide-interval="3000"
          style={`view-transition-name: project-${project.id}`}
        >
          <div
            class="featured-project-card-media"
            style={imagePlaceholderStyle(imagePlaceholderById.get(project.id))}
          >
            {slides ? (
              slides.map((img, i) => (
                <Image
                  src={img}
                  alt={`${project.data.title} screenshot ${i + 1}`}
                  class:list={['featured-project-card-img', 'slide-img', i === 0 && 'is-active']}
                  widths={[320, 480, 700, 960, 1280, 1600]}
                  sizes={
                    index > 0
                      ? '(max-width: 359px) calc(100vw - 32px), (max-width: 600px) calc((100vw - 44px) / 2), (max-width: 900px) 32rem, 45vw'
                      : '(max-width: 600px) calc(100vw - 32px), (max-width: 900px) 32rem, 45vw'
                  }
                  quality={88}
                />
              ))
            ) : (
              <div class="featured-project-card-placeholder" />
            )}
            {hasSlides && (
              <div class="slide-dots" aria-hidden="true">
                {slides!.map((_, i) => (
                  <span class:list={['slide-dot', i === 0 && 'is-active']} />
                ))}
              </div>
            )}
            <div class="featured-project-card-veil" />
            <div class="featured-project-card-hover">
              <span class="featured-project-card-arrow" aria-hidden="true">↗</span>
            </div>
          </div>
          <div class="featured-project-card-body">
            <h3 class="featured-project-card-title">{project.data.title}</h3>
            {project.data.description && (
              <p class="featured-project-card-desc">{project.data.description}</p>
            )}
            {project.data.tags && project.data.tags.length > 0 && (
              <div class="featured-project-card-tags">
                {project.data.tags.slice(0, 3).map((tag: string) => (
                  <span class="tag-badge">{tag}</span>
                ))}
                {project.data.tags.length > 3 && (
                  <span class="tag-badge">+{project.data.tags.length - 3}</span>
                )}
              </div>
            )}
          </div>
        </a>
      );
    })
  }
</div>

<script>
  function mountSlideshows() {
    document.querySelectorAll<HTMLElement>('[data-slideshow="true"]').forEach((card) => {
      const imgs = card.querySelectorAll<HTMLElement>('.slide-img');
      const dots = card.querySelectorAll<HTMLElement>('.slide-dot');
      if (imgs.length < 2) return;

      let current = 0;
      let interval = parseInt(card.dataset.slideInterval ?? '3000', 10);
      let timer: ReturnType<typeof setInterval>;

      function goTo(next: number) {
        imgs[current].classList.remove('is-active');
        dots[current]?.classList.remove('is-active');
        current = (next + imgs.length) % imgs.length;
        imgs[current].classList.add('is-active');
        dots[current]?.classList.add('is-active');
      }

      function start(speed = interval) {
        clearInterval(timer);
        timer = setInterval(() => goTo(current + 1), speed);
      }

      start();
      card.addEventListener('mouseenter', () => start(2500));
      card.addEventListener('mouseleave', () => start(interval));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mountSlideshows);
  } else {
    mountSlideshows();
  }
</script>

<style>
  /* ── Slideshow ── */
  .slide-img {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 600ms ease-in-out, transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .slide-img.is-active {
    opacity: 1;
  }

  .featured-project-card:hover .slide-img.is-active {
    transform: scale(1.05);
    filter: saturate(1.08) contrast(1.03);
  }

  .slide-dots {
    position: absolute;
    bottom: var(--space-3);
    left: 50%;
    transform: translateX(-50%);
    z-index: 7;
    display: flex;
    gap: 5px;
  }

  .slide-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    transition: background var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .slide-dot.is-active {
    background: #fff;
    transform: scale(1.3);
  }

  /* ── Grid layout ── */
  .featured-project-grid {
    --featured-grid-gap: 20px;
    --featured-grid-height: 580px;
    --featured-top-height: 260px;
    --featured-slot-1-title: clamp(1.55rem, 1.8vw, 1.9rem);
    --featured-card-date-size: 0.76rem;

    display: grid;
    grid-template-columns: minmax(0, 1.28fr) minmax(0, 0.72fr);
    grid-template-rows:
      var(--featured-top-height)
      calc(var(--featured-grid-height) - var(--featured-top-height) - var(--featured-grid-gap));
    gap: var(--featured-grid-gap);
    align-items: stretch;
  }

  .featured-project-grid--related {
    --featured-grid-gap: 18px;
    --featured-grid-height: 510px;
    --featured-top-height: 232px;
    --featured-slot-1-title: clamp(1.42rem, 1.65vw, 1.72rem);
  }

  .featured-project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 0;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: transparent;
    box-shadow: none;
    transition:
      box-shadow var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-spring);
  }

  .featured-project-card--slot-1 {
    grid-column: 1;
    grid-row: 1 / span 2;
  }

  .featured-project-card--slot-2 {
    grid-column: 2;
    grid-row: 1;
  }

  .featured-project-card--slot-3 {
    grid-column: 2;
    grid-row: 2;
  }

  .featured-project-card:hover {
    box-shadow: none;
    transform: translateY(-3px);
    opacity: 1;
  }

  .featured-project-card-media {
    position: relative;
    height: 100%;
    min-height: 0;
    background:
      radial-gradient(
        circle at 26% 22%,
        color-mix(in srgb, var(--label-primary) 7%, transparent),
        transparent 34%
      ),
      linear-gradient(135deg, var(--fill-secondary), var(--fill-tertiary));
    isolation: isolate;
  }

  .featured-project-card-media::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      110deg,
      transparent 0%,
      color-mix(in srgb, var(--label-primary) 6%, transparent) 42%,
      transparent 72%
    );
    opacity: 0;
    transform: translateX(-28%);
    transition: opacity 220ms var(--ease-out);
    pointer-events: none;
  }

  .featured-project-card-media::after {
    content: '';
    position: absolute;
    inset: -14px;
    z-index: 1;
    background-image: var(--tone-image-placeholder);
    background-position: center;
    background-size: cover;
    filter: blur(16px);
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 260ms var(--ease-out);
    pointer-events: none;
  }

  .featured-project-card-veil {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0.3) 40%,
      transparent 100%
    );
    opacity: 0.72;
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  .featured-project-card:hover .featured-project-card-veil {
    opacity: 0.88;
  }

  .featured-project-card-hover {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    opacity: 0;
    transform: translate(8px, -8px);
    transition:
      opacity var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
  }

  .featured-project-card:hover .featured-project-card-hover {
    opacity: 1;
    transform: translate(0, 0);
  }

  .featured-project-card-arrow {
    font-size: 1.1rem;
    font-weight: 600;
  }

  .featured-project-card-body {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 6;
    padding: var(--space-5) var(--space-6);
    color: #fff;
    pointer-events: none;
  }

  .featured-project-card-title {
    margin: 0;
    font-size: var(--featured-slot-1-title);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: #fff;
  }

  .featured-project-card-desc {
    margin: var(--space-3) 0 0;
    font-size: var(--text-callout);
    line-height: 1.4;
    opacity: 0.85;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-project-card-tags {
    margin-top: var(--space-3);
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .tag-badge {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 0.7rem;
    color: #fff;
    white-space: nowrap;
  }

  .featured-project-card--slot-2 .featured-project-card-title,
  .featured-project-card--slot-3 .featured-project-card-title {
    font-size: 1.25rem;
  }

  .featured-project-card--slot-2 .featured-project-card-desc,
  .featured-project-card--slot-3 .featured-project-card-desc {
    display: none;
  }

  @keyframes featured-media-placeholder-sweep {
    from { transform: translateX(-100%); }
    to { transform: translateX(100%); }
  }

  @media (max-width: 900px) {
    .featured-project-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      height: auto;
    }

    .featured-project-card--slot-1,
    .featured-project-card--slot-2,
    .featured-project-card--slot-3 {
      grid-column: 1;
      grid-row: auto;
      height: 320px;
    }

    .featured-project-card-body {
      padding: var(--space-4) var(--space-5);
    }
  }

  @media (max-width: 600px) {
    .featured-project-card {
      height: 280px;
    }

    .featured-project-card-title {
      font-size: 1.25rem;
    }
  }
</style>
