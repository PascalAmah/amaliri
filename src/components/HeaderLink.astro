---
import type { HTMLAttributes } from 'astro/types';
import { isNavItemActive } from '../utils/nav-active';
import { withBase, withoutBase } from '../utils/paths';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const normalizedHref = typeof href === 'string' ? href : '/';
const pathname = withoutBase(Astro.url.pathname);
const isActive = isNavItemActive(pathname, normalizedHref);
---

<a
  href={withBase(normalizedHref)}
  data-nav-href={normalizedHref}
  aria-current={isActive ? 'page' : undefined}
  class:list={['nav-link', className, { active: isActive }]}
  {...props}
>
  <slot />
</a>

<style>
  .nav-link {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-caption-1);
    font-weight: var(--weight-regular);
    color: var(--label-secondary);
    text-decoration: none;
    text-underline-offset: 0.4em;
    text-decoration-thickness: 2px;
    text-decoration-color: transparent;
    transition:
      color var(--duration-fast) var(--ease-out),
      text-decoration-color var(--duration-fast) var(--ease-out),
      opacity var(--duration-fast) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--label-primary);
    font-weight: var(--weight-semibold);
    opacity: 0.72;
  }

  .nav-link.active,
  .nav-link.active:hover {
    color: var(--label-primary);
    font-weight: var(--weight-semibold);
    opacity: 1;
    text-decoration-line: underline;
    text-decoration-color: var(--accent-bright);
  }
</style>
